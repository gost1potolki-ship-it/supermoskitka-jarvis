NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Gemini Developer API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview

# DeepSeek API
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com

# OdiRouter
ODIROUTER_API_KEY=
ODIROUTER_MODEL=
ODIROUTER_BASE_URL=https://api.odirouter.ai/v1

# Firestore persistence (Jarvis runtime state only — jarvis_v1_*)
JARVIS_FIRESTORE_PROJECT_ID=
# Optional explicit service account (else Application Default Credentials):
JARVIS_FIRESTORE_CLIENT_EMAIL=
JARVIS_FIRESTORE_PRIVATE_KEY=
