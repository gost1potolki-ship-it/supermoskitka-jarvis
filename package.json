{
  "name": "supermoskitka-jarvis",
  "version": "0.1.0",
  "description": "AI manager backend for SuperMoskitka",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:gemini": "tsx scripts/smoke-gemini.ts",
    "smoke:deepseek": "tsx scripts/smoke-deepseek.ts",
    "models:odirouter": "tsx scripts/list-odirouter-models.ts",
    "smoke:odirouter": "tsx scripts/smoke-odirouter.ts",
    "smoke:odirouter:calculation": "tsx scripts/smoke-odirouter-calculation.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@google/genai": "^2.16.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "openai": "^7.4.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.1",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "prettier": "^3.5.3",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vitest": "^3.0.8"
  }
}
